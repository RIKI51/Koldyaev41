<Page x:Class="КольдяевКр.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:КольдяевКр"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage" FontFamily="Comic Sans MS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>


        
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <StackPanel Margin="5" Width="150" Height="15" Orientation="Vertical">
                <TextBlock Name="CountTextBlock" VerticalAlignment="Top" FontSize="13"></TextBlock>
            </StackPanel>
            <StackPanel Margin="5" Width="150" Height="50" Orientation="Vertical">
                <TextBlock Text="поиск по названию" TextAlignment="Center" Width="150" FontSize="15"></TextBlock>
                <TextBox Name="TBoxSearch" TextChanged="TBoxSearch_TextChanged" Width="150" FontSize="13"></TextBox>
            </StackPanel>
            
            <StackPanel Orientation="Vertical" Margin="20" Width="250">
                <RadioButton Content="По возрастанию стоимости" GroupName="Sort" Width="250" FontSize="13" Checked="RButtonUp_Checked" Name="RButtonUp"></RadioButton>
                <RadioButton Content="По убыванию стоимости" GroupName="Sort" Width="250" FontSize="13" Checked="RButtonDown_Checked" Name="RButtonDown"></RadioButton>
            </StackPanel>
            
            <StackPanel Orientation="Vertical"  Width="150" Margin="10">
                <TextBlock Text="фильтрация по скидке" TextAlignment="Center" Width="150" FontSize="13"></TextBlock>
                <ComboBox Name="ComboType" SelectionChanged="ComboType_SelectionChanged" FontSize="13" Width="150">
                    <TextBlock> Все диапазоны </TextBlock>
                    <TextBlock> от 0% до 9,99%</TextBlock>
                    <TextBlock> от 10% до 14,99%</TextBlock>
                    <TextBlock> от 15% и более</TextBlock>
                </ComboBox>
            </StackPanel>
        </WrapPanel>

        <ListView Name="ProductListView" Grid.Row="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="77"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Image Width="100" Grid.Column="0" Stretch="UniformToFill" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Image.Source>
                                <Binding Path="ProductPhotoFull">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            Res/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <StackPanel Grid.Column="1" Grid.Row="0">
                            <TextBlock Text="{Binding ProductName}"  FontSize="16"  VerticalAlignment="Top"></TextBlock>
                            <TextBlock Text="{Binding ProductDescription}"  HorizontalAlignment="Left"></TextBlock>

                            <TextBlock Text="{Binding ProductManufacturer}" HorizontalAlignment="Left"></TextBlock>
                            <TextBlock Text="{Binding ProductCost, StringFormat={}{0:0} рублей}" HorizontalAlignment="Left"></TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="Скидка" FontSize="12"></TextBlock>
                            <TextBlock Text="{Binding ProductDiscountAmount, StringFormat= {} {0:0} %}" FontSize="19"></TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
