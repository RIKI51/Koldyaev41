<Page x:Class="КольдяевКр.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:КольдяевКр"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Text="Логин" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="30"></TextBlock>
        <TextBlock Text="Пароль" Grid.Column="0" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="30" ></TextBlock>
        <Button Name="GostBtn" Click="GostBtn_Click"  Content="Войти как гость" Grid.Column="0" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"></Button>

        <TextBox Name="LoginTB"  Grid.Column="1" Grid.Row="0" Width="150" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBox>
        <TextBox Name="PassTB"  Grid.Column="1" Grid.Row="0" Width="150" Height="30" HorizontalAlignment="Center" VerticalAlignment="Bottom" ></TextBox>
        <Button Name ="LoginBtn" Click="LoginBtn_Click" Content="Войти" Grid.Column="1" Grid.Row="2" ></Button>

        
        <StackPanel x:Name="StackCP"  Grid.Column="0" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Hidden">
            <TextBlock Name="captchaOneWord" FontSize="22" Margin="30,0,0,0" ></TextBlock>
            <TextBlock Name="captchaTwoWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,5,0,0"></TextBlock>
            <TextBlock Name="captchaThreeWord" FontSize="22" TextDecorations="Strikethrough"></TextBlock>
            <TextBlock Name="captchaFourWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,10,0,0"></TextBlock>
        </StackPanel>

        <TextBox x:Name="CaptTB" Grid.Column="1" Grid.Row="1" Height="30" Width="150" Visibility="Hidden"></TextBox>
        
        
        
    </Grid>
</Page>
